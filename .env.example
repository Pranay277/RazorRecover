# RazorRecover environment configuration example.
# Copy to .env and fill in real values.
# Never put real secrets in this file.

# Application
APP_NAME=RazorRecover
APP_ENV=development
DEBUG=true

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg://razor:razor_dev_password@localhost:5433/razorrecover

# Redis connection
REDIS_URL=redis://localhost:6379/0

# Celery broker + result backend (async recovery execution)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Qdrant (vector store)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=razorrecover_knowledge

# RAG / knowledge-base retrieval settings
RAG_DEFAULT_TOP_K=5
# Embedding provider: "hash" (deterministic/local, good for demo + tests)
# or "ollama" (remote HTTP provider). Set RAG_EMBEDDING_MODEL accordingly.
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIM=256

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# LLM / decision-agent provider
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_NUM_PREDICT=800

# Policy / Safety Engine (RazorRecover demo defaults - NOT real Razorpay limits)
POLICY_VERSION=1
POLICY_DEFAULT_MAX_RETRIES=3
POLICY_DEFAULT_MAX_RISK_SCORE=0.70
POLICY_DEFAULT_MIN_RECOVERY_PROBABILITY=0.30
POLICY_DEFAULT_HIGH_VALUE_THRESHOLD=10000