# RazorRecover environment configuration example.
# Copy to .env and fill in real values.
# Never put real secrets in this file.

# Application
APP_NAME=RazorRecover
APP_ENV=development
DEBUG=true

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg://razor:razor_dev_password@localhost:5433/razorrecover

# Redis connection
REDIS_URL=redis://localhost:6379/0

# Qdrant (vector store)
QDRANT_URL=http://localhost:6333

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest